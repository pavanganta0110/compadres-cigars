# Copy to .env.local. Real values never go in git.
APP_ENV=local                          # local | staging | production
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=             # server only
AGE_GATE_SECRET=                       # >= 32 random chars; signs the 21+ cookie
NEXT_PUBLIC_SHOP_FILTERS=false

# Integrations stay off until configured AND approved (live only if APP_ENV=production AND *_APPROVED=true)
COMPADRES_AGE_PROVIDER=self_attestation
COMPADRES_PAYMENT_PROVIDER=mock        # mock | quickbooks. Mock is refused when APP_ENV=production. quickbooks not configured => payments unavailable (never mocked)
COMPADRES_PAYMENT_PRODUCTION_APPROVED=false   # live ONLY if APP_ENV=production AND this is "true"; otherwise Intuit's sandbox
COMPADRES_PAYMENT_WEBHOOK_SECRET=      # mock provider only: >= 16 random chars; HMAC-SHA256 hex in x-compadres-signature
COMPADRES_QUICKBOOKS_CLIENT_ID=        # Intuit developer app (sandbox keys until production is approved)
COMPADRES_QUICKBOOKS_CLIENT_SECRET=
COMPADRES_QUICKBOOKS_REDIRECT_URI=     # https://YOUR-SITE/admin/payments/quickbooks/callback (must match the Intuit app exactly)
COMPADRES_QUICKBOOKS_WEBHOOK_VERIFIER= # Intuit webhook verifier token
COMPADRES_TOKEN_ENCRYPTION_KEY=        # >= 32 random chars; encrypts the stored QuickBooks OAuth tokens. Losing it means reconnecting
COMPADRES_SHIPPING_PROVIDER=fedex
COMPADRES_SHIPPING_PRODUCTION_APPROVED=false
COMPADRES_FEDEX_API_BASE_URL=https://apis-sandbox.fedex.com
COMPADRES_FEDEX_CLIENT_ID=
COMPADRES_FEDEX_CLIENT_SECRET=
COMPADRES_FEDEX_ACCOUNT_NUMBER=
COMPADRES_FEDEX_ORIGIN_COUNTRY=US
COMPADRES_FEDEX_ORIGIN_STATE=MO
COMPADRES_FEDEX_ORIGIN_POSTAL_CODE=64131
EMAIL_PROVIDER_API_KEY=
CRON_SECRET=                           # random string; Vercel sends it as a Bearer token to /api/cron/tracking
COMPADRES_FEDEX_TRACK_CLIENT_ID=              # optional: FedEx project that has the Track API (keys are per project)
COMPADRES_FEDEX_TRACK_CLIENT_SECRET=
